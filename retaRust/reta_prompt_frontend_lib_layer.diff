+use std::path::PathBuf;
+
+use super::app::{run_rp, run_rp_one_shot};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum PromptFrontendKind {
+    Rp,
+    Rpl,
+    Rpb,
+    Rpe,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct PromptFrontendPreset {
+    pub kind: PromptFrontendKind,
+    pub start_with_vi_mode: bool,
+    pub one_shot: bool,
+}
+
+impl PromptFrontendPreset {
+    pub fn from_program_name(program_name: &str) -> Self {
+        match program_name {
+            "rpl" => Self {
+                kind: PromptFrontendKind::Rpl,
+                start_with_vi_mode: true,
+                one_shot: false,
+            },
+            "rpb" => Self {
+                kind: PromptFrontendKind::Rpb,
+                start_with_vi_mode: true,
+                one_shot: true,
+            },
+            "rpe" => Self {
+                kind: PromptFrontendKind::Rpe,
+                start_with_vi_mode: false,
+                one_shot: false,
+            },
+            _ => Self {
+                kind: PromptFrontendKind::Rp,
+                start_with_vi_mode: true,
+                one_shot: false,
+            },
+        }
+    }
+}
+
+pub fn run_prompt_frontend_from_env() -> i32 {
+    let argv = std::env::args().collect::<Vec<_>>();
+    run_prompt_frontend(argv)
+}
+
+pub fn run_prompt_frontend(argv: Vec<String>) -> i32 {
+    let program_name = PathBuf::from(
+        argv.first()
+            .cloned()
+            .unwrap_or_else(|| "rp".to_string()),
+    )
+    .file_name()
+    .map(|s| s.to_string_lossy().to_string())
+    .unwrap_or_else(|| "rp".to_string());
+
+    let preset = PromptFrontendPreset::from_program_name(&program_name);
+
+    if preset.one_shot {
+        run_rp_one_shot(argv, preset.start_with_vi_mode)
+    } else {
+        run_rp(argv, preset.start_with_vi_mode)
+    }
+}
