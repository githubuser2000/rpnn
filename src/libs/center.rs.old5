//
// Enum nPmEnum(IntEnum)
//
#[repr(i32)]
#[derive(Debug, Copy, Clone, IntoPrimitive, TryFromPrimitive)]
pub enum NpmEnum {
    galN = 2,
    gal1pN = 3,
    uniN = 4,
    uni1pN = 5,
    emoN = 6,
    emo1pN = 7,
    groeN = 8,
    groe1pN = 9,
}

impl NpmEnum {
    pub fn gal() -> (Self, Self) {
        (Self::galN, Self::gal1pN)
    }
    pub fn uni() -> (Self, Self) {
        (Self::uniN, Self::uni1pN)
    }
    pub fn emo() -> (Self, Self) {
        (Self::emoN, Self::emo1pN)
    }
    pub fn groe() -> (Self, Self) {
        (Self::groeN, Self::groe1pN)
    }
    pub fn n() -> (Self, Self, Self, Self) {
        (Self::galN, Self::uniN, Self::emoN, Self::groeN)
    }
    pub fn einsPn() -> (Self, Self, Self, Self) {
        (
            Self::gal1pN,
            Self::uni1pN,
            Self::emo1pN,
            Self::groe1pN,
        )
    }
}

//
// Regex-Konstanten
//
fn kpattern() -> &'static Regex {
    static KP: OnceLock<Regex> = OnceLock::new();
    KP.get_or_init(|| {
        Regex::new(r",(?![^\[\]\{\}\(\)]*[\]\}\)])").unwrap()
    })
}

//
// Primzahlkreuz_pro_contra_strs
//
fn primzahlkreuz_pro_contra_strs() -> &'static Vec<String> {
    static DATA: OnceLock<Vec<String>> = OnceLock::new();
    DATA.get_or_init(|| {
        i18n::Primzahlkreuz_pro_contra_strs_Dict::get((
            "Primzahlkreuz_pro_contra",
            "nachvollziehen_emotional_oder_geistig_durch_Primzahl-Kreuz-Algorithmus_(15)",
        ))
    })
}

//
// isZeilenBruchAngabe_betweenKommas
//
pub fn isZeilenBruchAngabe_betweenKommas(g: &str) -> bool {
    let pattern_str = format!(
        "^({}?-?\\d+/\\d+)(-\\d+/\\d+)?((\\+)(\\d+/\\d+))*$",
        i18n::befehle2()["v"]
    );
    let re = Regex::new(&pattern_str).unwrap();
    re.full_match(g).is_some()
}

//
// isZeilenBruchOrGanzZahlAngabe
//
pub fn isZeilenBruchOrGanzZahlAngabe(text: &str) -> bool {
    text.split(',')
        .all(|g| {
            isZeilenBruchAngabe_betweenKommas(g)
                || isZeilenAngabe_betweenKommas(g)
        })
}

//
// isZeilenBruchAngabe
//
pub fn isZeilenBruchAngabe(text: &str) -> bool {
    let parts: Vec<&str> = text.split(',').collect();
    let any_at_all = parts.iter().any(|t| !t.is_empty());

    parts.iter().all(|g| {
        isZeilenBruchAngabe_betweenKommas(g)
            || (g.is_empty() && any_at_all)
    })
}

//
// isZeilenAngabe
//
pub fn isZeilenAngabe(text: &str) -> bool {
    let parts: Vec<&str> = kpattern().split(text).collect();
    let any_at_all = parts.iter().any(|t| !t.is_empty());

    parts.iter().all(|g| {
        isZeilenAngabe_betweenKommas(g)
            || (g.is_empty() && any_at_all)
    })
}

//
// isZeilenAngabe_betweenKommas
//
pub fn isZeilenAngabe_betweenKommas(g: &str) -> bool {
    let pattern_str = format!(
        "^({}?-?\\d+)(-\\d+)?((\\+)(\\d+))*$",
        i18n::befehle2()["v"]
    );
    let re = Regex::new(&pattern_str).unwrap();

    re.full_match(g).is_some()
        || strAsGeneratorToListOfNumStrs(g).is_some()
        || strAsGeneratorToListOfNumStrs(&g[1..]).is_some()
}

//
// retaPromptHilfe
//
pub fn retaPromptHilfe() {
    let readme = i18n::readMeFileNames().retaPrompt;
    let mut path = env::current_dir().unwrap();
    path.push("doc");
    path.push(readme);

    let markdown_text = fs::read_to_string(path).unwrap();
    let ab_da = markdown_text.find("+++").unwrap_or(0);
    let re = Regex::new(r"\{#.*\}").unwrap();
    let cleaned = re.replace_all(&markdown_text, "");

    println!("{}", &cleaned[ab_da + 3..]);
}

//
// retaHilfe
//
pub fn retaHilfe() {
    let readme = i18n::readMeFileNames().reta;
    let mut path = env::current_dir().unwrap();
    path.push("doc");
    path.push(readme);

    let markdown_text = fs::read_to_string(path).unwrap();
    print!("{}", markdown_text);
}

