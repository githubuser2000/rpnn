+pub fn spalte_fuer_gegen_innen_aussen_seitlich_prim(
+    table: &mut Table,
+    rows_as_numbers: &mut RowSet,
+    tables: &mut Tables,
+) {
+    let end = tables.last_line_number.min(table.len().saturating_sub(1));
+    let values = (0..=end)
+        .map(|row| {
+            if row == 0 {
+                "Gegen / Innen / Außen / Seitlich / Prim".to_string()
+            } else {
+                let orientation = orientation_text(row);
+                let primeish = if could_be_prime_number_primzahlkreuz(row) {
+                    "primnah"
+                } else {
+                    "zusammengesetzt"
+                };
+                if orientation.is_empty() {
+                    primeish.to_string()
+                } else {
+                    format!("{orientation}; {primeish}")
+                }
+            }
+        })
+        .collect::<Vec<_>>();
+    append_generated_col(table, values);
+    register_generated_column(
+        tables,
+        rows_as_numbers,
+        table,
+        [ST::Universum].into_iter().collect(),
+        "Gegen/Innen/Außen/Seitlich/Prim".to_string(),
+    );
+}
