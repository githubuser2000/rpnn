+        ds.remove(&1);
+
+        if ds.is_empty() {
+            schnittmenge = None;
+            break;
+        }
+
+        schnittmenge = match schnittmenge {
+            None => Some(ds),
+            Some(prev) => Some(prev.intersection(&ds).copied().collect()),
+        };
+    }
+
+    match schnittmenge {
+        Some(s) if !s.is_empty() => 3,
+        _ => 2,
+    }
